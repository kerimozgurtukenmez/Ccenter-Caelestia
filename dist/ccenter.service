# Ccenter arka plan servisi (systemd kullanıcı servisi), make install ile /usr/lib/systemd/user altına kurulur.
# Uygulamadaki "Oturum açılınca arka planda başlat" anahtarı bunu etkinleştirir/devre dışı bırakır.
# Elle: systemctl --user enable --now ccenter.service   |   kapatmak: systemctl --user disable --now ccenter.service
[Unit]
Description=Ccenter - fan ve klavye kontrol merkezi (arka plan)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
# Pencere açılmadan başlar; açmak için: ccenter
ExecStart=/usr/bin/ccenter --background
# Durdururken önce düzgün kapanmasını iste: klavye efekti sabit renge, fanlar NBFC'ye döner (Tamamen kapat ile aynı)
ExecStop=-/usr/bin/ccenter quit
# Yine de (çökme, zaman aşımı) fanlar NBFC'nin otomatik kontrolüne döner
ExecStopPost=-/usr/bin/nbfc set -a
Restart=on-failure
RestartSec=3
# Başka bir Ccenter kopyası açıksa ccenter 3 ile çıkar: tekrar tekrar başlatmaya çalışma
RestartPreventExitStatus=3

[Install]
WantedBy=graphical-session.target
