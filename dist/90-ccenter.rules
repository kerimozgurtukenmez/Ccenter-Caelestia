# Ccenter: write access so the keyboard light's colour and brightness can be set without root.
# Only touches the "brightness" and (if RGB) "multi_intensity" files of *::kbd_backlight devices.
# Manual equivalent: echo "r g b" | sudo tee .../multi_intensity   and   echo N | sudo tee .../brightness
# Never installed silently: install.sh asks, or the app's grant button adds it (with the admin password).
# Location: /etc/udev/rules.d/90-ccenter.rules. Removing it restores the permissions (0644).
ACTION=="add|change", SUBSYSTEM=="leds", KERNEL=="*::kbd_backlight", RUN+="/bin/sh -c 'chmod 0666 /sys%p/brightness; [ -e /sys%p/multi_intensity ] && chmod 0666 /sys%p/multi_intensity; true'"
