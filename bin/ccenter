#!/bin/sh
# Ccenter başlatıcısı ve terminal komutları.
# Uygulama klasörü sırayla: CCENTER_DIR, proje klasörü (bin/ccenter'dan çalışınca),
# <önek>/share/ccenter (~/.local/bin/ccenter → ~/.local/share/ccenter), /usr/share/ccenter.

set -u

self=$(readlink -f "$0")
if [ -n "${CCENTER_DIR:-}" ]; then
    dir=$CCENTER_DIR
elif [ -f "${self%/bin/ccenter}/shell.qml" ]; then
    dir=${self%/bin/ccenter}                      # geliştirme kopyası
elif [ -f "${self%/bin/ccenter}/share/ccenter/shell.qml" ]; then
    dir=${self%/bin/ccenter}/share/ccenter        # kurulu (önek düzeni: ~/.local ya da /usr)
else
    dir=/usr/share/ccenter
fi

if [ ! -f "$dir/shell.qml" ]; then
    echo "ccenter: uygulama dosyaları bulunamadı ($dir)" >&2
    exit 1
fi
command -v qs >/dev/null 2>&1 || { echo "ccenter: quickshell (qs) kurulu değil" >&2; exit 1; }

usage() {
    cat <<EOF
Kullanım: ccenter [komut]

  (komutsuz)         Pencereyi aç; uygulama çalışmıyorsa başlat
  --background       Pencere açmadan başlat (systemd servisi bunu kullanır)
  open | hide | toggle
  status             Fanlar, sıcaklıklar, aktif profil
  profiles           Profilleri listele (* = aktif)
  profile <ad>       Profil uygula (büyük/küçük harf fark etmez)
  boost <dk>         Maksimum fan: dakika, 0 = kapat, -1 = süresiz
  kbd                Klavye ışığı durumu
  kbd color <#hex>   Klavye rengi (ör. kbd color "#ff0000")
  kbd brightness <%> Klavye parlaklığı 0-100
  kbd effect <ad>    Klavye efekti: static | breathing (nefes) | cycle (renk geçişi)
  kbd source <ad>    Efekt renkleri: single (seçilen) | multi (liste) | theme (Caelestia)
  kbd speed <%>      Efekt hızı 0-100
  kbd range <% %>    Nefesin en düşük ve en yüksek seviyesi (ör. kbd range 10 90)
  kbd themecount <n> Caelestia kaynağında renk sayısı (3-6)
  quit               Tamamen kapat (Ccenter'ın kontrol ettiği fanlar NBFC'ye döner)
  --help | --version
EOF
}

# Bu kopya çalışıyor mu?
running() { qs ipc -p "$dir" show >/dev/null 2>&1; }

# Başka bir Ccenter kopyası (geliştirme ya da kurulu) çalışıyor mu? İkisi aynı anda fanları sürmemeli.
other_instance() {
    qs list --all 2>/dev/null | awk -v me="$dir/shell.qml" '
        /Config path:/ { p = $3; low = tolower(p)
                         if (p != me && low ~ /ccenter\/shell\.qml$/) { print p; exit } }'
}

ipc() { qs ipc -p "$dir" call cc "$@"; }

need_running() {
    running || { echo "ccenter: uygulama çalışmıyor (başlatmak için: ccenter)" >&2; exit 1; }
}

# Başlatmadan önce: başka kopya varsa uyar ve çık
guard() {
    other=$(other_instance)
    if [ -n "$other" ]; then
        echo "ccenter: başka bir Ccenter kopyası çalışıyor: $other" >&2
        echo "İki kopya aynı anda fanları kontrol etmesin diye başlatılmadı. Önce onu kapat." >&2
        exit 3                                    # servis bu kodda yeniden denemez (RestartPreventExitStatus=3)
    fi
}

case "${1:-}" in
    "")
        if running; then ipc open; else guard; qs -p "$dir" -n -d >/dev/null 2>&1; fi ;;
    --background)
        guard; exec env CCENTER_BACKGROUND=1 qs -p "$dir" -n ;;
    open|hide|toggle|status|profiles|quit)
        need_running; ipc "$1" ;;
    profile)
        [ $# -ge 2 ] || { echo "Kullanım: ccenter profile <ad>" >&2; exit 2; }
        need_running; shift; ipc profile "$*" ;;
    boost)
        [ $# -ge 2 ] || { echo "Kullanım: ccenter boost <dakika>" >&2; exit 2; }
        need_running; ipc boost -- "$2" ;;
    kbd)
        need_running
        case "${2:-}" in
            "") ipc kbd ;;
            color) [ $# -ge 3 ] || { echo "Kullanım: ccenter kbd color <#rrggbb>" >&2; exit 2; }; ipc kbdColor "$3" ;;
            brightness) [ $# -ge 3 ] || { echo "Kullanım: ccenter kbd brightness <0-100>" >&2; exit 2; }; ipc kbdBrightness -- "$3" ;;
            effect) [ $# -ge 3 ] || { echo "Kullanım: ccenter kbd effect <static|breathing|cycle>" >&2; exit 2; }; ipc kbdEffect "$3" ;;
            themecount) [ $# -ge 3 ] || { echo "Kullanım: ccenter kbd themecount <3-6>" >&2; exit 2; }; ipc kbdThemeCount -- "$3" ;;
            source) [ $# -ge 3 ] || { echo "Kullanım: ccenter kbd source <single|multi|theme>" >&2; exit 2; }; ipc kbdSource "$3" ;;
            range) [ $# -ge 4 ] || { echo "Kullanım: ccenter kbd range <en düşük %> <en yüksek %>" >&2; exit 2; }; ipc kbdRange -- "$3" "$4" ;;
            speed) [ $# -ge 3 ] || { echo "Kullanım: ccenter kbd speed <0-100>" >&2; exit 2; }; ipc kbdSpeed -- "$3" ;;
            *) echo "Kullanım: ccenter kbd [color <#hex> | brightness <0-100> | effect <ad> | source <ad> | speed <0-100>]" >&2; exit 2 ;;
        esac ;;
    -h|--help|help)
        usage ;;
    -V|--version)
        v=$(cat "$dir/VERSION" 2>/dev/null || echo "?"); echo "ccenter $v ($dir)" ;;
    *)
        echo "ccenter: bilinmeyen komut: $1" >&2; usage >&2; exit 2 ;;
esac
